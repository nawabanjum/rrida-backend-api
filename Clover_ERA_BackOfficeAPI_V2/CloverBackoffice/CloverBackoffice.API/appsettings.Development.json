{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Endpoints hidden from the Swagger UI. PRESENTATION ONLY — every one of
  // these is still routed, still authorised exactly as before, and still
  // callable by anything that knows the URL. Never rely on this for access.
  //
  // Temporary, for the RRIDA manager-onboarding integration. These three do
  // most of what api/manager-onboarding/create-manager does and are the ones
  // most likely to be wired up by mistake instead of it:
  //
  //   upsert-user           creates the user and sends the invitation, but
  //                         assigns no team
  //   upsert-team           creates the team, but leaves it with no manager
  //   assign-user-to-team   links the two afterwards, and emails the manager a
  //                         second time
  //
  // Empty this array to put them back. Config only — no code change, no
  // redeploy. Swagger runs in Development only, so this file is the only place
  // the setting has any effect.
  "Swagger": {
    // The only controllers currently in use. Everything else is dropped from the
    // Swagger document — PRESENTATION ONLY, exactly like HiddenEndpoints below:
    // every hidden endpoint is still routed, still authorised the same way and
    // still callable by anything that knows the URL.
    //
    // Names are controller names without the "Controller" suffix; a single
    // trailing "*" matches a prefix. Delete this array to show everything again,
    // or add a name to put one controller back.
    //
    //   AccountRegistration    api/profile/* — user list, upsert-user, units, roles
    //   ProfileRegistration    POST api/profile/Create, the Profile Admin sign-up
    //   TeamSetup              api/team-setup/*
    //   Mobile*                the four api/v1/* controllers in Controllers/Mobile
    //   ManagerOnboarding      api/manager-onboarding/*
    //   TeamHierarchy          api/teamhierarchy/* — assign-user-to-team, unassign-team-manager
    //   LicenseAssignments     api/license-assignments/* — licence details, manager-team-usage
    //   RridaReferenceData     api/rrida/reference-data/* — load and read the engine kit
    //   RridaEngineRun         api/rrida/engine/* — team settings, seed, run, narrate
    //   EngineManager          api/rrida/manager/* — state, active action, feed, acknowledge,
    //                          confirm, decline, roll-up: the Eran dashboard's action card.
    //   EngineCheckIn          api/v1/engine/* — the member app: enrol, today, answer, notes
    //   EranCoach              api/eran-coach/* — manager coach chat and conversations (admin routes hidden in code)
    //   ManagerActions         api/actions — manager-created actions (create, list, details, update)
    //   PlanManagement         api/admin/plans — RRIDA Admin plan catalogue (plans, price tiers, features, comparison)
    //   PlanFeatures           api/admin/plan-features — RRIDA Admin feature rows of the plan comparison table
    //   Plans                  api/plans — active plans + price quote (any logged-in user)
    //   Entitlements           api/entitlements — a user's plan features, limits, usage, team capacity
    //   Subscription           api/subscription/* — Stripe checkout, add licences, renew, cancel/reactivate, detail
    //   License                api/license/change — move one licence to monthly/annual via Stripe checkout
    //   Payment                api/payment/history (the Stripe webhook itself stays hidden)
    //   DailyQuestion          api/daily-question/* — calendar-invite (.ics or text), calendar-invite/email
    "VisibleControllers": [
      "Subscription",
      "License",
      "Payment",
      "AccountRegistration",
      "ProfileRegistration",
      "TeamSetup",
      "Mobile*",
      "ManagerOnboarding",
      "TeamHierarchy",
      "LicenseAssignments",
      "TeamHealth",
      "ManagerActions",
      "PlanManagement",
      "PlanFeatures",
      "Plans",
      "Entitlements",
      "Teams",
      "RridaReferenceData",
      "RridaEngineRun",
      "EngineManager",
      "EngineCheckIn",
      "EranCoach",
      "Portfolio",
      "DailyQuestion"
    ],
    "HiddenEndpoints": [
      "POST /api/company/upsert-user",
      "POST /api/teamhierarchy/upsert-team"
    ]
  },
  // Stripe keys/webhook secret are loaded per-environment from Azure Key Vault
  // (Environment:Name = Development → "Dev" secrets). Nothing Stripe-secret here.
  //
  // RRIDA Team Manager products in the Stripe test sandbox. Price ids are NOT
  // secret. Keep the two amounts below equal to those prices: the app shows
  // them in the UI ($695/month, $695 × 10 = $6,950/year).
  // EnvironmentTag marks Stripe objects as Dev's, so this API ignores events
  // from Pre-Prod or Clovera that share the same Stripe sandbox.
  "Stripe": {
    "MonthlyPriceId": "price_1UOaShH26LHsqVep7lljv4Az", // RRIDA Team Manager Monthly, $695/month
    "AnnualPriceId": "price_1UOaTDH26LHsqVepkJsy9Snm", // RRIDA Team Manager Annual, $6,950/year
    "PricePerLicenseMonthly": 695,
    "AnnualPriceMultiplier": 10,
    "EnvironmentTag": "dev"
  }
}
