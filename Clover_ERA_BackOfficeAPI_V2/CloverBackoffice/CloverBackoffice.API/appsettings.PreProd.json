  // Per-job schedule configuration consumed by every hosted BackgroundService
  // through IOptionsMonitor<JobScheduleOptions>.Get(<JobName>).
  //
  // Mode = "Daily"    → service fires at each entry in DailyTimes (UTC "HH:mm").
  // Mode = "Interval" → service fires every IntervalMinutes (double, fractions
  //                     allowed). Use for local testing.
  // Enabled = false   → hosted service exits at startup without running.
  //
  // Default for every job below is twice a day at 00:00 and 12:00 UTC. To
  // switch any single job to fast-cadence testing, change just its block,
  // e.g.:
  //   "SubscriptionLifecycle": { "Mode": "Interval", "IntervalMinutes": 1 }
  "JobSchedules": {
      "EngineDailyRun": {
        "Enabled": true, // set true to switch the engine on
        "Mode": "Daily",
        "DailyTimes": [ "02:00" ], // UTC
        "IntervalMinutes": 60,
        "StartupDelaySeconds": 30
      },
      "SubscriptionLifecycle": {
        "Enabled": true, // false = service exits at startup; the job never runs
        "Mode": "Daily", // "Daily" → run at DailyTimes; "Interval" → run every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // UTC clock times "HH:mm" — add/remove to change when the job runs (only used when Mode="Daily")
        "IntervalMinutes": 1, // how many minutes between runs (only used when Mode="Interval"). 1 = every 1 min, 60 = hourly, 240 = every 4 h, 1440 = once a day
        "StartupDelaySeconds": 20 // seconds to wait after the API boots before the FIRST run (gives DB / DI time to warm up). Doesn't affect later runs.
      },

      // Azure OpenAI batch-job polling: advances in-flight batches and persists
      // their insights. This is the work the removed CloverBackoffice.Jobs
      // Function App used to drive from outside, on a 5-minute timer trigger;
      // the Interval default below reproduces that cadence in-process.
      "BatchPolling": {
        "Enabled": true, // false = service exits at startup; batches stop advancing
        "Mode": "Interval", // "Daily" -> run at DailyTimes; "Interval" -> run every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // UTC clock times "HH:mm" when Mode="Daily"
        "IntervalMinutes": 5, // matches the 5-minute cron of the Function App this replaces
        "StartupDelaySeconds": 20 // seconds to wait after API boot before the FIRST run
      },

      // Polls completed Stripe / LLM batch jobs and writes their results.
      "BatchProcessing": {
        "Enabled": false, // false = service exits at startup; the job never runs
        "Mode": "Daily", // "Daily" → run at DailyTimes; "Interval" → run every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // UTC clock times "HH:mm" when Mode="Daily"
        "IntervalMinutes": 5, // minutes between runs when Mode="Interval"
        "StartupDelaySeconds": 5 // seconds to wait after API boot before the FIRST run
      },

      // Daily-feedback audit log writer.
      "DailyFeedbackAudit": {
        "Enabled": false, // false = service exits at startup
        "Mode": "Daily", // "Daily" → DailyTimes; "Interval" → every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // UTC times when Mode="Daily"
        "IntervalMinutes": 10, // minutes between runs when Mode="Interval"
        "StartupDelaySeconds": 5 // first-run delay after API boot, in seconds
      },

      // Team-daily-feedback audit log writer. Same snapshot-diff audit as above,
      // against TeamDailyFeedback.
      "TeamDailyFeedbackAudit": {
        "Enabled": false, // false = service exits at startup
        "Mode": "Daily", // "Daily" DailyTimes; "Interval" every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // UTC times when Mode="Daily"
        "IntervalMinutes": 10, // minutes between runs when Mode="Interval"
        "StartupDelaySeconds": 5 // first-run delay after API boot, in seconds
      },

      // Custom question expiry sweep. Moves a custom question to Expired once
      // the UTC day its ScheduledAt falls in has ended. Enabled by default: it is
      // what keeps Status honest. The read endpoint checks the same period against
      // the clock, so turning this off delays the status change, it does not leak
      // an out-of-date question.
      "CustomQuestionExpiry": {
        "Enabled": true, // false = service exits at startup; statuses stop being corrected
        "Mode": "Daily", // "Daily" DailyTimes; "Interval" every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // 00:00 is the one that matters - the moment the previous day stops being valid. Must stay equal to the JobScheduleOptions default: the binder APPENDS a configured list to the default rather than replacing it, and only Distinct() in JobScheduleHelper hides that when the two match
        "IntervalMinutes": 60, // minutes between runs when Mode="Interval"
        "StartupDelaySeconds": 30 // first-run delay after API boot, in seconds
      },

      // Per-unit scheduled report runner. Day-count logic (ReportGenerationDays
      // per unit in LLMReportSchedules table) is NOT affected by this section —
      // these settings only control how often we WAKE UP to evaluate it.
      "ReportScheduler": {
        "Enabled": false, // false = service exits at startup
        "Mode": "Daily", // "Daily" → DailyTimes; "Interval" → every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // UTC times when Mode="Daily"
        "IntervalMinutes": 60, // minutes between runs when Mode="Interval" (60 = hourly was the original cadence)
        "StartupDelaySeconds": 15 // first-run delay after API boot, in seconds
      },

      // Background importer for the FeedbackData.xlsx file. Per-row processing
      // logic is in the service; this section only times the trigger.
      "FeedbackAutoImport": {
        "Enabled": false, // false = service exits at startup. NOTE: FeedbackAutoImport.Enabled (separate section) must ALSO be true
        "Mode": "Daily", // "Daily" → DailyTimes; "Interval" → every IntervalMinutes
        "DailyTimes": [ "00:00", "12:00" ], // UTC times when Mode="Daily"
        "IntervalMinutes": 1, // minutes between runs when Mode="Interval" (0.0167 ≈ 1 second; use small values only for local testing)
        "StartupDelaySeconds": 5 // first-run delay after API boot, in seconds
      },
      // TEST DATA: wake-up for the dummy engine check-in. Which teams, and the
      // workbook, are under "EngineDummyCheckIn"; both Enabled flags must be true.
      // Re-running on the same day is harmless: answered members are skipped.
      "EngineDummyCheckIn": {
        "Enabled": true, // false = service exits at startup. EngineDummyCheckIn.Enabled must ALSO be true
        "Mode": "Daily", // "Daily" → DailyTimes; "Interval" → every IntervalMinutes
        "DailyTimes": [ "09:00" ], // UTC times when Mode="Daily"
        "IntervalMinutes": 60, // minutes between runs when Mode="Interval"
        "StartupDelaySeconds": 30 // first-run delay after API boot, in seconds
      },

      // New-team onboarding nudges (day 2 / day 5 after a team is created).
      // Which teams are DUE is decided per team from its registration date in
      // TeamOnboardingNotifications below; this section only times the wake-up.
      // Once a day in the morning: a nudge about "yesterday" is a morning message.
      "TeamOnboardingNotifications": {
        "Enabled": false, // false = service exits at startup
        "Mode": "Daily", // "Daily" → DailyTimes; "Interval" → every IntervalMinutes
        "DailyTimes": [ "08:00" ], // UTC times when Mode="Daily"
        "IntervalMinutes": 60, // minutes between runs when Mode="Interval"
        "StartupDelaySeconds": 20 // first-run delay after API boot, in seconds
      }
    },

    // Day 2 / Day 5 emails + in-app notifications to a NEW team's manager.
    //   Day 2 → "you've had X responses yesterday"
    //   Day 5 → "you're averaging X responses per day — log in to see your scores"
    //
    // Only PAID teams are notified: a team covered by a complimentary grant, or
    // with no live purchased licence, is skipped (its scores page would be empty).
    // A "response" is counted exactly as the Team Structure page counts it.
    // Manager notifications: team assigned/unassigned, the day 2 and day 5
    // onboarding nudges, the daily no-response alert, and the Action Hub
    // inactivity alert. The wake-up cadence is under
    // "JobSchedules:TeamOnboardingNotifications"; the thresholds are here.
    "TeamOnboardingNotifications": {
      "Enabled": false, // false = no onboarding nudges are sent
      "NotifyOnManagerAssignment": false,
      "NotifyOnManagerUnassignment": false,
      "NewTeamGraceDays": 14,
      "Day2AfterDays": 2, // days after the manager was assigned, for the first nudge
      "Day5AfterDays": 5, // days after the manager was assigned, for the second nudge
      "CatchUpDays": 2, // extra days a nudge stays eligible — covers a manager assigned late, or a missed run
      "NoResponseAlertEnabled": false,
      "NoResponseAlertCooldownDays": 1,
      "SkipNoResponseAlertDuringOnboarding": false, // day 2 already covers "no responses yet" for brand-new teams
      "ActionHubIdleAlertEnabled": false,
      "ActionHubIdleDays": 7,
      "ActionHubIdleCooldownDays": 7,
      "ActionHubAlertOnlyIfActionsExist": false, // only alert teams that actually have actions in the hub
      "ActionHubUrlPath": "/actionhub",
      "ScoresUrlPath": "/teams" // appended to SendGrid:FrontendBaseUrl for the "see your scores" link
    },

    // Report cadence for Business Units the Clovera Admin never configured.
    // Units WITH an enabled row in LLMReportSchedules keep using their own
    // ReportGenerationDays — this section does not touch them. Units without one
    // used to be ignored by the scheduler entirely; they now generate a report
    // every IntervalDays. Both paths still require an ACTIVE license on the unit.
    "ReportGenerationFallback": {
      "Enabled": false, // false = only explicitly scheduled units generate reports (pre-fallback behaviour)
      "IntervalDays": 14 // days between automatic reports for unscheduled units. <= 0 disables the fallback
    },

    // Admin review + approval gate between report generation and the manager
    // notification. With Enabled = true a generated report lands as PendingReview
    // and reaches NO manager until a reviewer approves it via
    // POST /api/report-approvals/{id}/approve.
    //
    // ReviewerEmails is both the notification list and the API allow-list: a
    // caller must be a CloverERAAdmin AND appear here. An empty list therefore
    // closes the queue rather than opening it. Override per environment with
    // ReportApproval__ReviewerEmails__0 / __1 / __2 in Azure App Settings.
    "ReportApproval": {
      "Enabled": false, // false = pre-review behaviour: the scheduler releases each report immediately
      "ReviewerEmails": [ "Muhammad.N.Anjum@cloverera.com", "cloveradev@yopmail.com" ], // the three admins who review and release reports
      "ReviewUrlPath": "/history", // appended to SendGrid:FrontendBaseUrl for the "review" link — the workbench history screen, where the admin reviews and publishes
      "NotifyCooldownHours": 0, // 0 = email the reviewers on every run that queues new reports
      "NotifyManagerOnWorkbenchPublish": false // publishing from the workbench (save-run-insights) notifies the manager, as approving via the review API does. First release only
    },

    // Kill switches for the report paths that predate the scheduled job. The
    // AppSettings-configured background service above (JobSchedules:ReportScheduler
    // → GuardShortageJob) is the authoritative automated report-generation flow;
    // each switch here is an ALTERNATIVE way a report could be created and
    // published, skipping the schedule, the licence gate and the admin review.
    // All default to false. The code behind them is retained, not deleted — set a
    // flag to true to bring one back with no code change.
    "LegacyReportPaths": {
      "AnalyzeByDaysEnabled": false, // GET /api/feedbackanalysis/get-analysis-by-days — a GET that also created+published a report
      "BatchPollPublishEnabled": false, // RagService batch-poll — deleted the unit's last-14-days report and replaced it, published
      "ManualBatchInsightsEnabled": false // POST /api/rag/approved-batchinsights-manually — published a report from posted JSON
    },

