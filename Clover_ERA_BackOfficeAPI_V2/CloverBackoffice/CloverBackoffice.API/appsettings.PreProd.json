  "Swagger": {
    // The only controllers currently in use. Everything else is dropped from the
    // Swagger document — PRESENTATION ONLY, exactly like HiddenEndpoints below:
    // every hidden endpoint is still routed, still authorised the same way and
    // still callable by anything that knows the URL.
    //
    // Names are controller names without the "Controller" suffix; a single
    // trailing "*" matches a prefix. Delete this array to show everything again,
    // or add a name to put one controller back.
    //
    //   AccountRegistration    api/profile/* — user list, upsert-user, units, roles
    //   ProfileRegistration    POST api/profile/Create, the Profile Admin sign-up
    //   TeamSetup              api/team-setup/*
    //   Mobile*                the four api/v1/* controllers in Controllers/Mobile
    //   ManagerOnboarding      api/manager-onboarding/*
    //   TeamHierarchy          api/teamhierarchy/* — assign-user-to-team, unassign-team-manager
    //   LicenseAssignments     api/license-assignments/* — licence details, manager-team-usage
    //   TeamHealth             api/team-health/* — timeline, milestones, custom questions
    //   Teams                  api/teams/* — the Weekly Flags the Team Health page reads
    //   RridaReferenceData     api/rrida/reference-data/* — load and read the engine kit
    //   RridaEngineRun         api/rrida/engine/* — team settings, seed, run, narrate
    //   EngineManager          api/rrida/manager/* — state, active action, feed, acknowledge,
    //                          confirm, decline, roll-up: the Eran dashboard's action card.
    //   EngineCheckIn          api/v1/engine/* — the member app: enrol, today, answer, notes
    //   EranCoach              api/eran-coach/* — manager coach chat and conversations (admin routes hidden in code)
    //   Subscription           api/subscription/* — Stripe checkout, add licences, renew, cancel/reactivate, detail
    //   License                api/license/change — move one licence to monthly/annual via Stripe checkout
    //   Payment                api/payment/history (the Stripe webhook itself stays hidden)
    //   DailyQuestion          api/daily-question/* — calendar-invite (.ics or text), calendar-invite/email
    //
    // This list must be kept in step with appsettings.Development.json: a controller
    // added there and not here is visible in Dev and missing in UAT, which reads as
    // a deployment problem and is not one.
    "VisibleControllers": [
      "Subscription",
      "License",
      "Payment",
      "AccountRegistration",
      "ProfileRegistration",
      "TeamSetup",
      "Mobile*",
      "ManagerOnboarding",
      "TeamHierarchy",
      "LicenseAssignments",
      "TeamHealth",
      "ManagerActions",
      "PlanManagement",
      "PlanFeatures",
      "Plans",
      "Entitlements",
      "Teams",
      "RridaReferenceData",
      "RridaEngineRun",
      "EngineManager",
      "EngineCheckIn",
      "EranCoach",
      "Portfolio",
      "DailyQuestion"
    ],
    "HiddenEndpoints": [
      "POST /api/company/upsert-user",
      "POST /api/teamhierarchy/upsert-team"
    ]
