{
  // Licensing feature flags. LaunchDateUtc is the production go-live date of the
  // licensed-metrics feature. Teams registered BEFORE it are treated as legacy
  // (their metrics history is grandfathered back to team registration so no
  // pre-feature data is lost). Teams registered on/after it are filtered strictly
  // to their licensed periods. Leave null until the real launch date is known —
  // null means "not launched yet", so ALL existing companies are treated as legacy.
  // Daily question rotation. TimeZoneId is the zone the rotation day is counted in;
  // leave null to use the server's local date. Set it to "UTC" to count days exactly
  // as the mobile API does, or to a zone id such as "India Standard Time" to keep the
  // rotation aligned with the business day.
  // InviteEmail is the mail sent by POST /api/daily-question/calendar-invite/email.
  // Body is html — the subject is always "RRIDA Daily Check-in" and the link to the created
  // event is appended after it. {{TeamCode}} and {{FeedbackLink}} are replaced per team.
  "DailyQuestion": {
    "TimeZoneId": null,
    "InviteEmail": {
      "Body": "<h2>Welcome to RRIDA</h2><p>Help to make your team healthier and higher performing!</p><h3>Why Your Participation Matters</h3><p>This isn't about tracking or micromanaging; your feedback is ANONYMOUS and helps your manager to improve your team health!</p><ul><li>Quick, science-backed check in questions</li><li>Less than 30 seconds a day</li></ul><p>All you have to do is open the RRIDA Feedback webapp and submit your feedback daily: <a href=\"{{FeedbackLink}}\">{{FeedbackLink}}</a></p><p>-This reminder will pop-up once a day to remind you, you can set the timing to whatever you prefer.</p><p>You can also download and submit your feedback using our apps:</p><p>-App Store link<br/><a href=\"https://apps.apple.com/us/app/rrida/id6808233654\">https://apps.apple.com/us/app/rrida/id6808233654</a></p><p>-Play Store link<br/><a href=\"https://play.google.com/store/apps/details?id=com.cloverera.rrida_app&amp;pcampaignid=web_share\">https://play.google.com/store/apps/details?id=com.cloverera.rrida_app&amp;pcampaignid=web_share</a></p><p>The apps are easy to use, require no sign-up and your feedback is also anonymous.</p><p>Questions? <a href=\"mailto:support@rrida.com\">support@rrida.com</a></p><p>&copy; 2026 RRIDA. All Rights Reserved.<br/><a href=\"https://www.rrida.com\">https://www.rrida.com</a></p>",
      "EventLinkLabel": "Open the calendar event"
    }
  },
